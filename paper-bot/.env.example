# Example settings. On Render you set these in the dashboard (Environment tab);
# the Blueprint already fills them in. Never commit a real .env file.
WEBHOOK_SECRET=make-a-long-random-string
DASHBOARD_TOKEN=make-another-long-random-string
TEST_MODE=true
STARTING_BALANCE=10000
FEE_RATE=0.001
FEE_FIXED=0
DEFAULT_ORDER_USD=1000
MAX_ORDER_USD=2000
MAX_DAILY_LOSS_USD=300
DEFAULT_STOP_LOSS_PCT=2
ALLOW_FRACTIONAL=true
DEDUP_WINDOW_SECONDS=86400
TIMEZONE=America/New_York
DB_PATH=data/paperbot.db
